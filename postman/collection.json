        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login realizado com sucesso', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "const token = response.token || response.accessToken || response.jwt || '';",
                  "",
                  "function decodeJwtPayload(jwt) {",
                  "  const base64Url = jwt.split('.')[1];",
                  "  const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');",
                  "  const jsonPayload = decodeURIComponent(atob(base64).split('').map(function (c) {",
                  "    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);",
                  "  }).join(''));",
                  "  return JSON.parse(jsonPayload);",
                  "}",
                  "",
                  "if (token) {",
                  "  pm.collectionVariables.set('token', token);",
                  "",
                  "  try {",
                  "    const payload = decodeJwtPayload(token);",
                  "",
                  "    if (payload.userId || payload.id) {",
                  "      pm.collectionVariables.set('userId', String(payload.userId || payload.id));",
                  "    }",
                  "",
                  "    if (payload.sub) {",
                  "      pm.collectionVariables.set('userEmail', String(payload.sub));",
                  "    }",
                  "",
                  "    if (payload.role) {",
                  "      pm.collectionVariables.set('userRole', String(payload.role));",
                  "    }",
                  "  } catch (e) {",
                  "    console.log('Falha ao decodificar JWT:', e);",
                  "  }",
                  "}"]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Autenticar usuário principal e capturar JWT, userId, userEmail e userRole."
          },
          "response": []
        },
